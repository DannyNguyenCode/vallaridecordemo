{% liquid
  assign card_image = product.featured_image
  assign card_variant = product.selected_or_first_available_variant

  if card_image.alt != blank
    assign card_image_alt = card_image.alt
  else
    assign card_image_alt = product.title
  endif

  assign is_on_sale = false

  if product.compare_at_price_max > product.price
    assign is_on_sale = true
  endif
%}

<article class="vallari-product-card">
  <a
    class="vallari-product-card__link"
    href="{{ product.url }}"
  >
    <div class="vallari-product-card__media">
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 900
          | image_tag:
            class: 'vallari-product-card__image',
            widths: '220, 320, 420, 600, 750, 900',
            sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw',
            loading: 'lazy',
            alt: card_image_alt
        }}
      {% else %}
        <div
          class="vallari-product-card__placeholder"
          aria-hidden="true"
        >
          {{ 'product-1' | placeholder_svg_tag: 'vallari-product-card__placeholder-svg' }}
        </div>
      {% endif %}

      <div class="vallari-product-card__badges">
        {% unless product.available %}
          <span class="vallari-product-card__badge vallari-product-card__badge--sold-out"> Sold Out </span>
        {% elsif is_on_sale %}
          <span class="vallari-product-card__badge"> Sale </span>
        {% endunless %}
      </div>
    </div>

    <div class="vallari-product-card__content">
      <h3 class="vallari-product-card__title">
        {{ product.title | escape }}
      </h3>

      <div class="vallari-product-card__price">
        {% if product.price_varies %}
          <span class="vallari-product-card__price-prefix"> From </span>
        {% endif %}

        <span class="vallari-product-card__price-current">
          {{ product.price | money }}
        </span>

        {% if is_on_sale %}
          <s class="vallari-product-card__price-compare">
            {{ product.compare_at_price_max | money }}
          </s>
        {% endif %}
      </div>
    </div>
  </a>
</article>
{% stylesheet %}
  .vallari-product-card {
    box-sizing: border-box;

    display: flex;
    flex-direction: column;

    min-width: 0;
    height: 100%;
  }

  .vallari-product-card__link {
    box-sizing: border-box;

    display: flex;
    flex-direction: column;

    height: 100%;

    padding: var(--layout-card-padding, 0.75rem);

    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);

    border-radius: var(--radius-card, 1.5rem);

    background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));

    color: var(--color-foreground);
    text-decoration: none;

    transition: transform var(--motion-duration-fast, 200ms) ease, border-color var(--motion-duration-fast, 200ms) ease;
  }

  /* Image */

  .vallari-product-card__media {
    position: relative;

    width: 100%;
    aspect-ratio: 3 / 4;

    overflow: hidden;

    border-radius: var(--radius-image, 1.25rem);

    background: var(--color-surface);
  }

  .vallari-product-card__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform var(--motion-duration-fast, 200ms) ease;
  }

  .vallari-product-card__placeholder {
    width: 100%;
    height: 100%;
  }

  .vallari-product-card__placeholder-svg {
    display: block;

    width: 100%;
    height: 100%;
  }

  /* Badges */

  .vallari-product-card__badges {
    position: absolute;

    top: 0.75rem;
    left: 0.75rem;

    z-index: 2;

    display: flex;
    flex-wrap: wrap;

    gap: 0.4rem;
  }

  .vallari-product-card__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 1.75rem;

    padding: 0.35rem 0.7rem;

    border-radius: 999px;

    background: var(--color-accent);
    color: var(--color-background);

    font-family: var(--font-primary--family);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;

    letter-spacing: 0.06em;

    text-transform: uppercase;
  }

  .vallari-product-card__badge--sold-out {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  /* Content */

  .vallari-product-card__content {
    display: flex;
    flex-direction: column;

    gap: 0.35rem;

    padding-top: 0.75rem;
  }

  .vallari-product-card__title {
    margin: 0;

    color: var(--color-foreground);

    font-family: var(--font-primary--family);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;

    overflow-wrap: anywhere;

    transition: color var(--motion-duration-fast, 200ms) ease;
  }

  .vallari-product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.4rem;

    color: var(--color-text-muted);

    font-family: var(--font-primary--family);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .vallari-product-card__price-current {
    font-weight: 600;
  }

  .vallari-product-card__price-prefix {
    font-size: 0.8125rem;
  }

  .vallari-product-card__price-compare {
    opacity: 0.7;
  }

  /* Accessibility */

  .vallari-product-card__link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  /* Desktop hover */

  @media (hover: hover) and (pointer: fine) {
    .vallari-product-card__link:hover {
      transform: translateY(var(--motion-hover-lift, -2px));

      border-color: var(--color-accent);
    }

    .vallari-product-card__link:hover .vallari-product-card__image {
      transform: scale(1.035);
    }

    .vallari-product-card__link:hover .vallari-product-card__title {
      color: var(--color-accent);
    }
  }

  /* Reduced motion */

  @media (prefers-reduced-motion: reduce) {
    .vallari-product-card__link,
    .vallari-product-card__image,
    .vallari-product-card__title {
      transition: none;
    }

    .vallari-product-card__link:hover {
      transform: none;
    }

    .vallari-product-card__link:hover .vallari-product-card__image {
      transform: none;
    }
  }
{% endstylesheet %}
