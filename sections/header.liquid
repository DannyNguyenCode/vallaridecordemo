{% liquid
  assign brand_name = section.settings.brand_name | default: shop.name
%}

{% comment %}
  Generate the menu once and reuse it for desktop and mobile.
  This version supports the current top-level navigation links.
{% endcomment %}

{% capture navigation_links %}
  <ul class="header__menu-list">
    {% for link in section.settings.menu.links %}
      <li>
        <a
          href="{{ link.url | escape }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{ link.title | escape }}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endcapture %}

<header class="site_header">
  <div class="vallari-container header__inner">
    <div class="header__brand">
      <a
        class="header__brand-link"
        href="{{ routes.root_url }}"
        aria-label="{{ brand_name | escape }} home"
      >
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 96
            | image_tag: class: 'header__brand-image', widths: '48, 96', sizes: '32px', loading: 'eager', alt: ''
          }}
        {% else %}
          <img
            class="header__brand-image"
            src="{{ 'logo.jpg' | asset_url }}"
            alt=""
            width="48"
            height="48"
            loading="eager"
          >
          {% comment %}
            <span class="header__brand-mark" aria-hidden="true">
              {{ brand_name | slice: 0, 1 | upcase | escape }}
            </span>
          {% endcomment %}
        {% endif %}

        <span class="header__brand-text">
          {{ brand_name | escape }}
        </span>
      </a>
    </div>

    {% if section.settings.menu.links != blank %}
      <nav class="header__desktop-menu" aria-label="Main navigation">
        {{ navigation_links }}
      </nav>
    {% endif %}

    <div class="header__icons">
      <a
        class="header__action header__search"
        href="{{ routes.search_url }}"
        aria-label="Search"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4.5 4.5" />
        </svg>

        <span class="header__action-label">Search</span>
      </a>

      {% if shop.customer_accounts_enabled %}
        <shopify-account
          menu="{{ section.settings.customer_account_menu }}"
        >
          <span slot="signed-out-avatar" aria-hidden="true">
            {{ 'icon-account.svg' | inline_asset_content }}
          </span>
        </shopify-account>
      {% endif %}

      <a
        class="header__action header__cart"
        href="{{ routes.cart_url }}"
        aria-label="Cart, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}"
      >
        <span aria-hidden="true">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>

        <span class="header__action-label">Cart</span>

        {% if cart.item_count > 0 %}
          <span class="header__cart-count" aria-hidden="true">
            {% if cart.item_count > 99 %}
              99+
            {% else %}
              {{ cart.item_count }}
            {% endif %}
          </span>
        {% endif %}
      </a>

      {% if section.settings.menu.links != blank %}
        <details class="header__mobile-menu">
          <summary class="header__action" aria-label="Menu">
            <svg
              class="header__menu-open-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>

            <svg
              class="header__menu-close-icon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m6 6 12 12M18 6 6 18" />
            </svg>
          </summary>

          <nav
            class="header__mobile-panel"
            aria-label="Mobile navigation"
          >
            {{ navigation_links }}
          </nav>
        </details>
      {% endif %}
    </div>
  </div>
</header>

{% stylesheet %}
  .shopify-section.vallari-header-section {
    display: block;
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  @supports (backdrop-filter: blur(6px)) {
    .shopify-section.vallari-header-section {
      background: color-mix(in srgb, var(--color-background) 90%, transparent);
      backdrop-filter: blur(6px);
    }
  }

  .site_header {
    color: var(--color-foreground);
  }

  .site_header .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-height: 4rem;
    padding-block: 0.5rem;
    gap: 0;
  }

  .site_header a {
    color: inherit;
    text-decoration: none;
  }

  .site_header a:focus-visible,
  .site_header summary:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .site_header .header__brand,
  .site_header .header__desktop-menu,
  .site_header .header__icons {
    flex: 0 1 30%;
    min-width: 0;
  }
  .site_header .header__brand {
    display: flex;
    align-items: center;
    justify-content: space-evenly;
  }
  .site_header .header__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-height: 44px;
  }

  .site_header .header__brand-mark,
  .site_header .header__brand-image {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
  }

  .site_header .header__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: var(--gradient-brand);
    font-weight: 700;
  }

  .site_header .header__brand-image {
    display: block;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .site_header .header__brand-text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-heading--family, var(--font-primary--family));
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Navigation */
  .site_header .header__desktop-menu {
    flex: 0 1 24rem;
    min-width: 0;
    max-width: 40%;
  }

  .site_header .header__menu-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-evenly;
    width: 100%;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site_header .header__menu-list a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
    transition: color var(--motion-duration-fast) ease;
  }

  .site_header .header__menu-list a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .site_header .header__menu-list a[aria-current='page'] {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .site_header .header__icons {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: center;
    gap: 0.5rem;
  }

  .site_header .header__action,
  .site_header shopify-account::part(signed-out-avatar) {
    box-sizing: border-box;
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-control-background);
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
    transition: border-color var(--motion-duration-fast) ease, background-color var(--motion-duration-fast) ease;
  }

  .site_header .header__action:hover,
  .site_header shopify-account::part(signed-out-avatar):hover {
    border-color: var(--color-accent);
  }

  .site_header .header__icons svg {
    display: block;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .site_header .header__action-label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .site_header shopify-account {
    display: block;
    flex: 0 0 44px;
    width: 44px;
    border-radius: var(--radius-pill);
    --shopify-account-avatar-size: 44px;
    --shopify-account-signed-in-avatar-size: 44px;
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-color-accent: var(--color-button-background);
    --shopify-account-color-accent-text: var(--color-button-text);
  }

  .site_header shopify-account::part(signed-out-avatar) {
    width: 44px;
    height: 44px;
    padding: 0;
  }

  .site_header shopify-account:focus-within {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .site_header .header__cart {
    background: var(--color-button-background);
    border-color: var(--color-button-background);
    color: var(--color-button-text);
  }

  .site_header .header__cart:hover {
    background: var(--color-button-background-hover);
    border-color: var(--color-button-background-hover);
  }

  .site_header .header__cart-count {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    min-height: 1.25rem;
    padding-inline: 0.25rem;
    border: 1px solid var(--color-background);
    border-radius: var(--radius-pill);
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Mobile navigation uses native details/summary behaviour. */
  .site_header .header__mobile-menu {
    display: none;
    flex-shrink: 0;
  }

  .site_header .header__mobile-menu summary {
    list-style: none;
  }

  .site_header .header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .site_header .header__icons .header__menu-close-icon,
  .site_header .header__mobile-menu[open] .header__menu-open-icon {
    display: none;
  }

  .site_header .header__mobile-menu[open] .header__menu-close-icon {
    display: block;
  }

  .site_header .header__mobile-panel {
    position: absolute;
    top: 100%;
    left: var(--page-margin);
    right: var(--page-margin);
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-background);
  }

  .site_header .header__mobile-panel .header__menu-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
  }

  .site_header .header__mobile-panel a {
    padding-inline: 0.5rem;
  }
  @media (min-width: 1024px) {
    .site_header .header__icons > .header__search {
      flex: 0 1 16rem;
      min-width: 8rem;
      /* margin-inline-end: auto; */
      justify-content: flex-start;
      padding-inline: 1rem;
    }
  }
  @media (max-width: 1023px) {
    .site_header .header__inner {
      gap: 0.75rem;
    }

    .site_header .header__desktop-menu,
    .site_header .header__action-label {
      display: none;
    }

    .site_header .header__icons {
      flex: 0 0 auto;
      gap: 0.375rem;
    }

    .site_header .header__action {
      width: 44px;
      padding: 0;
    }

    .site_header .header__mobile-menu {
      display: block;
    }
  }

  @media (max-width: 379px) {
    .site_header .header__brand-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site_header *,
    .site_header shopify-account::part(signed-out-avatar) {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /*
   * Delegated listeners also work when Shopify reloads the header
   * inside the theme editor.
   */
  const openHeaderMenus = () => document.querySelectorAll('.site_header .header__mobile-menu[open]');

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    openHeaderMenus().forEach((menu) => {
      const clickedOutside = !menu.contains(event.target);
      const clickedLink = event.target.closest('a');

      if (clickedOutside || clickedLink) {
        menu.open = false;
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    openHeaderMenus().forEach((menu) => {
      const hadFocus = menu.contains(document.activeElement);
      menu.open = false;

      if (hadFocus) {
        menu.querySelector('summary')?.focus();
      }
    });
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (!event.matches) return;

    openHeaderMenus().forEach((menu) => {
      const hadFocus = menu.contains(document.activeElement);
      menu.open = false;

      if (hadFocus) {
        menu.closest('.site_header')?.querySelector('.header__brand-link')?.focus();
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "class": "vallari-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Display name",
      "default": "Vallari Decor",
      "info": "Shown beside the logo. Leave empty to use the store name."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
