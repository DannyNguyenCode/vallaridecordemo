{% liquid
  assign button_url = section.settings.button_link | default: routes.all_products_collection_url
%}

<div class="vallari-hero__inner">
  <div class="vallari-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="vallari-hero__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}

    <h1 class="vallari-hero__heading">
      {{ section.settings.heading | escape }}
    </h1>

    {% if section.settings.description != blank %}
      <p class="vallari-hero__description">
        {{ section.settings.description | escape }}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        class="vallari-hero__button"
        href="{{ button_url | escape }}"
      >
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">↗</span>
      </a>
    {% endif %}
  </div>

  <div class="vallari-hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1500
        | image_tag:
          class: 'vallari-hero__image',
          widths: '375, 550, 750, 1100, 1500',
          sizes: '(min-width: 1500px) 700px, (min-width: 750px) 50vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% else %}
      <img
        class="vallari-hero__image"
        src="{{ 'homedecorhero.png' | asset_url }}"
        alt=""
        width="1500"
        height="1500"
        loading="eager"
      >
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .vallari-hero {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding-block: clamp(2.5rem, 6vw, 6rem);
  }

  .vallari-hero__inner {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    width: min(calc(100% - 3rem), 87.5rem);
    margin-inline: auto;
  }

  .vallari-hero__content,
  .vallari-hero__media {
    flex: 1 1 0;
    min-width: 0;
  }

  .vallari-hero__eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-foreground);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .vallari-hero__heading {
    max-width: 14ch;
    margin: 0;
    color: var(--color-foreground);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.5rem, 4.5vw, 4.75rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .vallari-hero__description {
    max-width: 36ch;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.7;
  }

  .vallari-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: 3rem;
    margin-top: 2rem;
    padding: 0.875rem 1.5rem;
    border: 1px solid var(--color-button-background);
    border-radius: 0.25rem;
    background-color: var(--color-button-background);
    color: var(--color-button-text);
    font-weight: 600;
    text-decoration: none;
  }

  .vallari-hero__button:hover {
    background-color: var(--color-button-background-hover);
    border-color: var(--color-button-background-hover);
  }

  .vallari-hero__button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .vallari-hero__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 1.5rem;
    background-color: var(--color-surface);
  }

  .vallari-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vallari-hero__placeholder {
    height: 100%;
  }

  @media (max-width: 749px) {
    .vallari-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
    }

    .vallari-hero__content,
    .vallari-hero__media {
      flex: none;
    }

    .vallari-hero__media {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vallari hero",
  "tag": "section",
  "class": "vallari-hero",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Vallari Decor"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Making the world a prettier place!"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Décor for weddings, celebrations, and the spaces you call home."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to all products."
    }
  ],
  "presets": [
    {
      "name": "Vallari hero"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
