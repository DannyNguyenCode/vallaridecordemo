        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          {
            "value": "80rem",
            "label": "Standard — 1280px"
          },
          {
            "value": "90rem",
            "label": "Wide — 1440px"
          },
          {
            "value": "110rem",
            "label": "Extra wide — 1760px"
          }
        ],
        "default": "80rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Mobile side spacing",
        "default": 20
      },
      {
        "type": "range",
        "id": "desktop_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Desktop side spacing",
        "default": 32
      },
      {
        "type": "header",
        "content": "Rounded corners"
      },
      {
        "type": "range",
        "id": "image_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Images",
        "default": 20
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Cards",
        "default": 24
      },
      {
        "type": "range",
        "id": "media_frame_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Large image frames",
        "default": 28
      }
    ]
  },
