{% liquid
  assign featured_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show

  if featured_collection != blank
    assign featured_products = featured_collection.products
  else
    assign featured_products = collections.all.products
  endif

  assign featured_products = featured_products | sort: 'created_at' | reverse
%}

{% if featured_products != blank or request.design_mode %}
  <section class="vallari-featured-products">
    <div class="vallari-featured-products__inner">
      <div class="vallari-featured-products__header">
        {% if section.settings.heading != blank %}
          <h2 class="vallari-featured-products__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.link_label != blank %}
          <a
            class="vallari-featured-products__view-all"
            href="{{ routes.all_products_collection_url }}"
          >
            {{ section.settings.link_label | escape }}

            <span aria-hidden="true"> ↗ </span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <p class="vallari-featured-products__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}

      {% if featured_products != blank %}
        <ul
          class="vallari-featured-products__grid"
          role="list"
        >
          {% for product in featured_products limit: products_to_show %}
            <li class="vallari-featured-products__item">
              {% render 'vallari-product-card', product: product %}
            </li>
          {% endfor %}
        </ul>

      {% elsif request.design_mode %}
        <p class="vallari-featured-products__empty">Select a collection to display products.</p>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .shopify-section.vallari-featured-products-section {
    display: block;

    background: var(--color-background);
    color: var(--color-foreground);
  }

  .vallari-featured-products__inner {
    box-sizing: border-box;

    width: 100%;
    max-width: var(--page-width, 80rem);

    margin-inline: auto;

    padding-inline: var(--page-margin, 20px);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  /* Header */

  .vallari-featured-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;

    gap: 1rem;

    margin-bottom: 1rem;
  }

  .vallari-featured-products__heading {
    margin: 0;

    color: var(--color-accent);

    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--font-heading--weight, 600);
    line-height: 1.2;
  }

  .vallari-featured-products__description {
    max-width: 60ch;

    margin: 0 0 1.75rem;

    color: var(--color-text-muted);

    font-size: 1rem;
    line-height: 1.6;
  }

  .vallari-featured-products__view-all {
    display: inline-flex;
    align-items: center;

    gap: 0.5rem;

    min-height: 44px;

    color: var(--color-foreground);

    font-size: 0.875rem;

    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .vallari-featured-products__view-all:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  /* Grid */

  .vallari-featured-products__grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: var(--layout-card-gap, 0.75rem);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  .vallari-featured-products__item {
    min-width: 0;
  }

  .vallari-featured-products__empty {
    margin: 0;

    color: var(--color-text-muted);
  }

  /* Tablet */

  @media (min-width: 640px) {
    .vallari-featured-products__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Desktop */

  @media (min-width: 1024px) {
    .vallari-featured-products__inner {
      padding-inline: var(--page-margin-desktop, 32px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vallari featured products",
  "tag": "section",
  "class": "vallari-featured-products-section",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Most Recent"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore the latest décor for weddings, events, and the spaces you call home."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection",
      "info": "Products from this collection will be displayed."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "All products link label",
      "default": "Explore all products"
    }
  ],

  "presets": [
    {
      "name": "Vallari featured products"
    }
  ],

  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
