<div id="faq" class="vallari-section-inner">
  {% if section.settings.use_page_heading %}
    <h1 class="vallari-section-heading">
      {{ section.settings.heading | escape }}
    </h1>
  {% else %}
    <h2 class="vallari-section-heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}

  <div class="vallari-faq__list">
    {% for block in section.blocks %}
      {% if block.settings.question != blank %}
        <details
          class="vallari-faq__item"
          {{ block.shopify_attributes }}
        >
          <summary class="vallari-faq__question">
            <span>{{ block.settings.question | escape }}</span>

            <svg
              class="vallari-faq__icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>

          <div class="vallari-faq__answer vallari-prose">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .vallari-section-heading {
    font-family: Georgia, 'Times New Roman', serif;
  }
  .vallari-faq__list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem;
  }

  .vallari-faq__item {
    box-sizing: border-box;
    flex: 0 0 calc((100% - 1rem) / 2);
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    border-radius: var(--radius-card, 1.5rem);
    background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .vallari-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 1.25rem;
    border-radius: inherit;
    color: var(--color-foreground);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    list-style: none;
    cursor: pointer;
  }

  .vallari-faq__question::-webkit-details-marker {
    display: none;
  }

  .vallari-faq__question > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .vallari-faq__question:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .vallari-faq__icon {
    flex-shrink: 0;
    transition: transform var(--motion-duration-fast, 200ms) ease;
  }

  .vallari-faq__item[open] .vallari-faq__icon {
    transform: rotate(180deg);
  }

  .vallari-faq__answer {
    padding: 0 1.25rem 1.25rem;
  }

  @media (max-width: 749px) {
    .vallari-faq__item {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vallari-faq__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vallari FAQ",
  "tag": "section",
  "class": "vallari-content-section vallari-faq",
  "limit": 1,
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "use_page_heading",
      "label": "Use as the page heading (H1)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Add a question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the confirmed answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vallari FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What kinds of décor do you sell?",
            "answer": "<p>Vallari Decor specializes in décor for weddings, events, homes, and commercial spaces.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where is Vallari Decor based?",
            "answer": "<p>Vallari Decor is a Canadian business based in Toronto, Ontario.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long will delivery take?",
            "answer": "<p>Demo placeholder: add owner-confirmed processing times and delivery estimates before launch.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Demo placeholder: add the owner-approved return policy and a link to the full policy before launch.</p>"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}
